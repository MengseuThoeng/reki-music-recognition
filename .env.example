# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_USER_IDS=123456789,987654321

# Local Telegram Bot API Server Credentials (for 2GB upload/download limit)
# Get from https://my.telegram.org -> API development tools
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here
LOCAL_BOT_API_URL=http://telegram-bot-api:8081/bot

# Database Configuration (SQLite default - zero setup)
SQLITE_DB_PATH=reki_music.db

# Bot Operational Flags
MAINTENANCE_MODE=false
UPDATE_MODE=false
MAX_CONCURRENT_TASKS=20
MAX_FILE_SIZE_MB=2000

# Channel & Developer Info
OFFICIAL_CHANNEL=@reki_anime_news
DEVELOPER_TAG=@RekiReze
